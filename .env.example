# Course applications from the Ta'lim form are POSTed as JSON to this URL
# (for example a Telegram bot relay, CRM or Google Apps Script endpoint).
# Put the real value in .env.local, never in source control.
APPLICATION_WEBHOOK_URL=

# Questionnaire backend API that serves site content (services, news, tabibs, products, courses).
CONTENT_API_URL=http://localhost:3000/api

# Shared secret the backend sends to /api/revalidate after admin edits (same value as the backend's REVALIDATE_SECRET).
REVALIDATE_SECRET=

# Public base URL of content images (the backend's S3_PUBLIC_URL), used to allow them in next/image.
CONTENT_MEDIA_URL=http://localhost:9000/content
